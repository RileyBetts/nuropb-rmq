# Example RabbitMQ config for local mTLS + SASL EXTERNAL smoke.
# Merge into brew rabbitmq.conf (or replace SSL section), then:
#   rabbitmq-plugins enable rabbitmq_auth_mechanism_ssl
#   rabbitmqctl add_user nuropb-client unused-password || true
#   rabbitmqctl set_permissions -p / nuropb-client ".*" ".*" ".*"
#   restart RabbitMQ
#
# Generate certs first: ./scripts/gen_amqps_certs.sh
# Adjust absolute paths to your checkout.

listeners.tcp.1 = 127.0.0.1:5673
listeners.ssl.1 = 127.0.0.1:5671

ssl_options.cacertfile = /ABS/PATH/TO/nuropb-rmq/dev/amqps/ca.pem
ssl_options.certfile   = /ABS/PATH/TO/nuropb-rmq/dev/amqps/server.pem
ssl_options.keyfile    = /ABS/PATH/TO/nuropb-rmq/dev/amqps/server.key
ssl_options.verify     = verify_peer
ssl_options.fail_if_no_peer_cert = true

# Map client certificate CN to the RabbitMQ username.
ssl_cert_login_from = common_name

auth_mechanisms.1 = PLAIN
auth_mechanisms.2 = AMQPLAIN
auth_mechanisms.3 = EXTERNAL
